DOMAIN=userscripts.example.net
# The dashboard's host name, served through oauth2-proxy
ADMIN_DOMAIN=userscripts-admin.example.net
# Self-hosted ntfy topic. Omit to disable
NTFY_URL=https://ntfy.example.net/userscripts
NTFY_TOKEN=
# Dex issuer URL, for the dashboard and the MCP server (no trailing slash)
MCP_OIDC_ISSUER=https://auth.example.net
# Comma-separated Dex emails allowed to use the dashboard and the MCP server
MCP_ALLOWED_EMAILS=user@example.net
# Secret of the confidential Dex client userscripts-web (redirect URI
# https://<ADMIN_DOMAIN>/oauth2/callback): openssl rand -hex 32
WEB_OIDC_CLIENT_SECRET=
# Signs oauth2-proxy's session cookie: openssl rand -base64 32 | tr -- '+/' '-_'
WEB_COOKIE_SECRET=
# MCP server /mcp
MCP_ENABLED=false
# Public URL of the MCP endpoint, as claude.ai reaches it
MCP_RESOURCE_URL=https://userscripts.example.net/mcp
